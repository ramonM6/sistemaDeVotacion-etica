# Copia este archivo a .env (npm run dev lo hace automáticamente si no existe)
DATABASE_URL="postgresql://votacion:votacion@localhost:5432/votacion?schema=public"

# Secreto para firmar el JWT de la cookie de sesión. Cámbialo.
JWT_SECRET="cambia-este-secreto-en-tu-maquina"

# Cuenta del coordinador (el seed la crea si no existe; conserva las credenciales existentes)
COORD_USER="coordinador"
COORD_PASSWORD="Coordinador#2026"

# Puerto del API y origen permitido por CORS (frontend Vite)
PORT=3000
WEB_ORIGIN="http://localhost:5173"

# Solo para actualizar archivos de versiones anteriores guardados cifrados en PostgreSQL.
# Conservar el valor original (o JWT_SECRET original) hasta completar la migración a Storage.
# ARCHIVOS_SECRET="usa-un-secreto-aleatorio-independiente"

# Archivos originales: bucket PRIVADO de Supabase Storage. Nunca usar prefijo VITE_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="votainf-importaciones"

# El mismo bucket privado contiene también las plantillas y ejemplos.
# Publicar en un bucket nuevo: npm run plantillas:publicar -w apps/api (desde la raíz).
